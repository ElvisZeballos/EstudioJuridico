generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ABOGADO
  CLIENTE
}

enum CasoEstado {
  ACTIVO
  EN_PROCESO
  CERRADO
  SUSPENDIDO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  password        String
  role            Role                 @default(CLIENTE)
  nombre          String
  apellido        String
  dni             String?
  telefono        String?
  direccion       String?
  fechaNacimiento String?
  photoPath       String?
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  clients         Client[]             @relation("AbogadoClientes")
  clientProfile   Client?              @relation("UserClientProfile")
  resetTokens     PasswordResetToken[]
  casos           CasoAbogado[]
  movimientos     Movimiento[]         @relation("AbogadoMovimientos")
  historialAutor  CasoHistorial[]      @relation("HistorialAutor")
  novedades       CasoNovedad[]        @relation("NovedadAutor")
}

model Juzgado {
  id        String   @id @default(uuid())
  nombre    String
  tipo      String?
  direccion String?
  ciudad    String?
  telefono  String?
  notas     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  casos     Caso[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Client {
  id              String    @id @default(uuid())
  nombre          String
  apellido        String
  dni             String
  email           String
  telefono        String?
  direccion       String?
  fechaNacimiento String?
  notas           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  abogadoId       String?
  abogado         User?     @relation("AbogadoClientes", fields: [abogadoId], references: [id])
  userId          String?   @unique
  user            User?     @relation("UserClientProfile", fields: [userId], references: [id])
  casos           CasoCliente[]
}

model Caso {
  id          String         @id @default(uuid())
  titulo      String
  descripcion String?
  estado      CasoEstado     @default(ACTIVO)
  numero      String?
  fechaInicio DateTime?
  fechaCierre DateTime?
  notas       String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  juzgadoId   String?
  juzgado     Juzgado?       @relation(fields: [juzgadoId], references: [id])
  abogados    CasoAbogado[]
  clientes    CasoCliente[]
  movimientos Movimiento[]
  historial   CasoHistorial[]
  novedades   CasoNovedad[]
}

model CasoHistorial {
  id           String   @id @default(uuid())
  casoId       String
  caso         Caso     @relation(fields: [casoId], references: [id])
  usuarioId    String
  usuario      User     @relation("HistorialAutor", fields: [usuarioId], references: [id])
  campo        String
  valorAntes   String?
  valorDespues String?
  createdAt    DateTime @default(now())
}

model CasoAbogado {
  casoId    String
  abogadoId String
  caso      Caso   @relation(fields: [casoId], references: [id])
  abogado   User   @relation(fields: [abogadoId], references: [id])

  @@id([casoId, abogadoId])
}

model CasoCliente {
  casoId    String
  clienteId String
  caso      Caso   @relation(fields: [casoId], references: [id])
  cliente   Client @relation(fields: [clienteId], references: [id])

  @@id([casoId, clienteId])
}

model Movimiento {
  id         String         @id @default(uuid())
  casoId     String
  caso       Caso           @relation(fields: [casoId], references: [id])
  abogadoId  String
  abogado    User           @relation("AbogadoMovimientos", fields: [abogadoId], references: [id])
  tipo       TipoMovimiento
  concepto   String
  monto      Decimal        @db.Decimal(10, 2)
  fecha      DateTime
  notas      String?
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model CasoNovedad {
  id         String   @id @default(uuid())
  casoId     String
  caso       Caso     @relation(fields: [casoId], references: [id])
  autorId    String
  autor      User     @relation("NovedadAutor", fields: [autorId], references: [id])
  titulo     String
  contenido  String
  fecha      DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
