generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ABOGADO
  CLIENTE
}

enum CasoEstado {
  ACTIVO
  EN_PROCESO
  CERRADO
  SUSPENDIDO
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  password        String
  role            Role                 @default(CLIENTE)
  nombre          String
  apellido        String
  dni             String?
  telefono        String?
  direccion       String?
  fechaNacimiento String?
  photoPath       String?
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  clients         Client[]             @relation("AbogadoClientes")
  clientProfile   Client?              @relation("UserClientProfile")
  resetTokens     PasswordResetToken[]
  casos           CasoAbogado[]
}

model Juzgado {
  id        String   @id @default(uuid())
  nombre    String
  tipo      String?
  direccion String?
  ciudad    String?
  telefono  String?
  notas     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Client {
  id              String    @id @default(uuid())
  nombre          String
  apellido        String
  dni             String
  email           String
  telefono        String?
  direccion       String?
  fechaNacimiento String?
  notas           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  abogadoId       String?
  abogado         User?     @relation("AbogadoClientes", fields: [abogadoId], references: [id])
  userId          String?   @unique
  user            User?     @relation("UserClientProfile", fields: [userId], references: [id])
  casos           CasoCliente[]
}

model Caso {
  id          String       @id @default(uuid())
  titulo      String
  descripcion String?
  estado      CasoEstado   @default(ACTIVO)
  numero      String?
  fechaInicio DateTime?
  fechaCierre DateTime?
  notas       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  abogados    CasoAbogado[]
  clientes    CasoCliente[]
}

model CasoAbogado {
  casoId    String
  abogadoId String
  caso      Caso   @relation(fields: [casoId], references: [id])
  abogado   User   @relation(fields: [abogadoId], references: [id])

  @@id([casoId, abogadoId])
}

model CasoCliente {
  casoId    String
  clienteId String
  caso      Caso   @relation(fields: [casoId], references: [id])
  cliente   Client @relation(fields: [clienteId], references: [id])

  @@id([casoId, clienteId])
}
