generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ABOGADO
  CLIENTE
  AUXILIAR
}

enum CasoEstado {
  ACTIVO
  PENDIENTE
  CONCLUIDO
  ARCHIVADO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  password           String
  role               Role                 @default(CLIENTE)
  nombre             String
  apellido           String
  dni                String?
  telefono           String?
  direccion          String?
  fechaNacimiento    String?
  photoPath          String?
  active             Boolean              @default(true)
  googleRefreshToken String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  clients            Client[]             @relation("AbogadoClientes")
  clientProfile      Client?              @relation("UserClientProfile")
  resetTokens        PasswordResetToken[]
  casos              CasoAbogado[]
  movimientos        Movimiento[]         @relation("AbogadoMovimientos")
  historialAutor     CasoHistorial[]      @relation("HistorialAutor")
  novedades          CasoNovedad[]        @relation("NovedadAutor")
  whatsappSession    WhatsAppSession?
  whatsappMessages   WhatsAppMessage[]
  auxiliares         AbogadoAuxiliar[] @relation("AbogadoAuxiliares")
  abogados           AbogadoAuxiliar[] @relation("AuxiliarAbogados")
}

model AbogadoAuxiliar {
  abogadoId  String
  auxiliarId String
  abogado    User   @relation("AbogadoAuxiliares", fields: [abogadoId], references: [id])
  auxiliar   User   @relation("AuxiliarAbogados", fields: [auxiliarId], references: [id])

  @@id([abogadoId, auxiliarId])
}

model Juzgado {
  id        String   @id @default(uuid())
  nombre    String
  tipo      String?
  direccion String?
  ciudad    String?
  telefono  String?
  notas     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  casos     Caso[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Client {
  id          String             @id @default(uuid())
  userId      String             @unique
  user        User               @relation("UserClientProfile", fields: [userId], references: [id])
  abogadoId   String?
  abogado     User?              @relation("AbogadoClientes", fields: [abogadoId], references: [id])
  notas       String?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  casos       CasoCliente[]
  referencias ClientReferencia[]
}

model ClientReferencia {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  nombre    String
  relacion  String
  telefono  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Caso {
  id                  String                   @id @default(uuid())
  titulo              String
  descripcion         String?
  estado              CasoEstado               @default(ACTIVO)
  numero              String?
  fechaInicio         DateTime?
  fechaCierre         DateTime?
  notas               String?
  active              Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  juzgadoId           String?
  juzgado             Juzgado?                 @relation(fields: [juzgadoId], references: [id])
  abogados            CasoAbogado[]
  clientes            CasoCliente[]
  movimientos         Movimiento[]
  historial           CasoHistorial[]
  novedades           CasoNovedad[]
  abogadosContraparte CasoAbogadoContraparte[]
  demandados          CasoDemandado[]
}

model CasoAbogadoContraparte {
  id        String   @id @default(uuid())
  casoId    String
  caso      Caso     @relation(fields: [casoId], references: [id])
  nombre    String
  direccion String?
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CasoDemandado {
  id        String   @id @default(uuid())
  casoId    String
  caso      Caso     @relation(fields: [casoId], references: [id])
  nombre    String
  domicilio String?
  carnet    String?
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CasoHistorial {
  id           String   @id @default(uuid())
  casoId       String
  caso         Caso     @relation(fields: [casoId], references: [id])
  usuarioId    String
  usuario      User     @relation("HistorialAutor", fields: [usuarioId], references: [id])
  campo        String
  valorAntes   String?
  valorDespues String?
  createdAt    DateTime @default(now())
}

model CasoAbogado {
  casoId    String
  abogadoId String
  caso      Caso   @relation(fields: [casoId], references: [id])
  abogado   User   @relation(fields: [abogadoId], references: [id])

  @@id([casoId, abogadoId])
}

model CasoCliente {
  casoId    String
  clienteId String
  caso      Caso   @relation(fields: [casoId], references: [id])
  cliente   Client @relation(fields: [clienteId], references: [id])

  @@id([casoId, clienteId])
}

model Movimiento {
  id         String         @id @default(uuid())
  casoId     String?
  caso       Caso?          @relation(fields: [casoId], references: [id])
  abogadoId  String
  abogado    User           @relation("AbogadoMovimientos", fields: [abogadoId], references: [id])
  tipo       TipoMovimiento
  concepto   String
  monto      Decimal        @db.Decimal(10, 2)
  fecha      DateTime
  notas      String?
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model WhatsAppSession {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creds     String   @db.Text
  keys      String   @db.Text
  connected Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  remoteJid String
  timestamp DateTime
  rawJson   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
}

model CasoNovedad {
  id                    String    @id @default(uuid())
  casoId                String
  caso                  Caso      @relation(fields: [casoId], references: [id])
  autorId               String
  autor                 User      @relation("NovedadAutor", fields: [autorId], references: [id])
  titulo                String
  contenido             String
  fecha                 DateTime
  fechaAgendada         DateTime?
  googleCalendarEventId String?
  esNotificacion        Boolean   @default(false)
  archivos              String?   @db.Text
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
